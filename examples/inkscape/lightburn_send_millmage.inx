<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Send to MillMage</name>
  <id>com.lightburnsoftware.send_millmage</id>
  <param name="app" type="string" gui-hidden="true">MillMage</param>
  <param name="tab" type="notebook">
    <page name="opts" gui-text="Options">
      <param name="dedupe" type="bool" gui-text="De-duplicate shared segments">true</param>
      <param name="selected_only" type="bool"
             gui-text="Selection only (uncheck to send the whole document)">true</param>
    </page>
    <page name="advanced" gui-text="Advanced">
      <param name="force" type="bool"
             gui-text="Send anyway (skip device/size check)">false</param>
      <label>To reach MillMage on another computer, enable network access in its
settings and set the host. Change the port only if you customised it.</label>
      <param name="host" type="string" gui-text="Host">localhost</param>
      <param name="port" type="int" min="1" max="65535" gui-text="Port">19521</param>
      <param name="reset_auth" type="bool"
             gui-text="Reset authorization (pair again on this run)">false</param>
      <label>Tick this if the connection fails with an authorization error. It
forgets the secret saved for this host and asks MillMage for a new consent
dialog. Other hosts keep their own authorization.</label>
    </page>
  </param>
  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="LightBurn / MillMage"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">lightburn_send.py</command>
  </script>
</inkscape-extension>
