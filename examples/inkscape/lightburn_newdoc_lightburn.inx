<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Set document to LightBurn workspace</name>
  <id>com.lightburnsoftware.newdoc_lightburn</id>
  <param name="app" type="string" gui-hidden="true">LightBurn</param>
  <param name="tab" type="notebook">
    <page name="opts" gui-text="Document">
      <label>Sizes the current document to LightBurn's workspace (1 mm = 1 user
unit). Make a new, blank document first, then run this.</label>
    </page>
    <page name="advanced" gui-text="Advanced">
      <label>To reach LightBurn on another computer, enable network access in its
settings and set the host. Change the port only if you customised it.</label>
      <param name="host" type="string" gui-text="Host">localhost</param>
      <param name="port" type="int" min="1" max="65535" gui-text="Port">19520</param>
    </page>
  </param>
  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="LightBurn / MillMage"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">lightburn_newdoc.py</command>
  </script>
</inkscape-extension>
